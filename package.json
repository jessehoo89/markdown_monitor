{
  "name": "dsh-doc2md",
  "version": "1.0.1",
  "description": "DeepSeek Harness plugin: convert local documents (docx / doc / xls / xlsx / pdf / images) to Markdown through the doc2md (markdown_monitor) CLI, with convert, read, scan and status actions.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || >=4.0.5-0 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.1.1-0 <0.2.0 || >=0.1.2-0 <0.2.0 || >=0.1.3-0 <0.2.0 || >=0.1.5-0 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.3.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "doc2md",
    "markdown",
    "document-conversion",
    "docx",
    "xlsx",
    "pdf",
    "ocr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jessehoo89/markdown_monitor.git"
  },
  "homepage": "https://github.com/jessehoo89/markdown_monitor#readme",
  "bugs": {
    "url": "https://github.com/jessehoo89/markdown_monitor/issues"
  }
}
